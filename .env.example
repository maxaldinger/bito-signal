# Bito Signal — environment
# Copy to .env.local for development; set the same vars in Vercel for deploys.

# ---------- Required ----------
# Anthropic API key with web_search enabled (Console → Settings → Privacy).
# Powers /api/signals, /api/intel and /api/assist.
ANTHROPIC_API_KEY=

# ---------- Optional: Anthropic tuning ----------
# Model override. Default: claude-sonnet-4-20250514.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Max web searches per request (default 5; signals route uses 8).
ANTHROPIC_WEB_SEARCH_MAX=5

# ---------- Optional: Supabase signal cache ----------
# When set, every scan upserts into public.bito_signals and the feed becomes
# a paged (50/page) history with "Pull More". Without these, the feed runs in
# ephemeral live-scan mode. Schema: see README (one row per account+type).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Optional: enrichment providers ----------
# Each unlocks part of /api/enrich (and the Live Enrichment panel in briefs).
# Missing keys degrade gracefully — the provider reports "not configured".

# Apollo.io — firmographics, people search, tech stack (incl. AI tooling).
# https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# Hunter.io — email pattern + finder + verification.
# https://hunter.io/api-keys
HUNTER_API_KEY=

# GitHub — public repo/commit/contributor stats. Works WITHOUT a token at
# 60 req/h; a classic PAT (no scopes needed) raises this to 5,000 req/h.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Proxycurl — LinkedIn company data (headcount, openings). NOTE: verify the
# service's operational status; see README.
PROXYCURL_API_KEY=

# Crunchbase API v4 — funding rounds, employee ranges, investors.
# https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=

# ---------- Optional: HubSpot CRM ----------
# Powers the "Check in HubSpot" + "Create task" buttons in a deep dive.
# Accepts EITHER credential:
#   - a Private App access token ("pat-na1-…"), used directly; or
#   - a Personal Access Key (Settings → Integrations → Private Apps → Personal
#     Access Key, or the CLI key), which the app exchanges for a short-lived
#     access token automatically.
# The underlying token needs read+write on companies, contacts and tasks.
HUBSPOT_TOKEN=

# Bito Signal — environment
# Copy to .env.local for development; set the same vars in Vercel for deploys.

# ---------- Required ----------
# Anthropic API key with web_search enabled (Console → Settings → Privacy).
# Powers /api/signals, /api/intel and /api/assist.
ANTHROPIC_API_KEY=

# ---------- Optional: Anthropic tuning ----------
# Model override. Default: claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cheaper model for high-volume structured/grading calls (signal grader +
# the assist tool modes). Default: claude-haiku-4-5. Deep web-search scans and
# the intel brief always use ANTHROPIC_MODEL above.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Max web searches per request (default 5; signals route uses 8).
ANTHROPIC_WEB_SEARCH_MAX=5

# ---------- Optional: Supabase signal cache ----------
# When set, every scan upserts into public.bito_signals and the feed becomes
# a paged (50/page) history with "Pull More". Without these, the feed runs in
# ephemeral live-scan mode. Schema: see README (one row per account+type).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Optional: enrichment providers ----------
# Each unlocks part of /api/enrich (and the Live Enrichment panel in briefs).
# Missing keys degrade gracefully — the provider reports "not configured".

# Apollo.io — firmographics, people search, tech stack (incl. AI tooling).
# https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# Hunter.io — email pattern + finder + verification.
# https://hunter.io/api-keys
HUNTER_API_KEY=

# GitHub — public repo/commit/contributor stats, and the GitHub Prospecting
# watchlist poll (stargazers/forks/PR authors). Works WITHOUT a token at
# 60 req/h (enough for a demo pull); a classic PAT (no scopes needed) raises
# this to 5,000 req/h — set it so the weekly watchlist sync covers all repos.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub Prospecting: minimum company size (total employees) before a resolved
# person is surfaced. People below the floor are suppressed, not deleted.
# Default: 100.
GITHUB_PROSPECT_MIN_EMPLOYEES=100

# Proxycurl — LinkedIn company data (headcount, openings). NOTE: verify the
# service's operational status; see README.
PROXYCURL_API_KEY=

# Crunchbase API v4 — funding rounds, employee ranges, investors.
# https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=

# ---------- Optional: HubSpot CRM ----------
# Powers the "Check in HubSpot" + "Create task" buttons in a deep dive.
# Accepts EITHER credential:
#   - a Private App access token ("pat-na1-…"), used directly; or
#   - a Personal Access Key (Settings → Integrations → Private Apps → Personal
#     Access Key, or the CLI key), which the app exchanges for a short-lived
#     access token automatically.
# The underlying token needs read+write on companies, contacts and tasks.
HUBSPOT_TOKEN=
# HubSpot owner (user) id to assign created tasks to, so they land in the rep's
# "my tasks" queue. Without it, tasks are created unassigned and won't show in
# the default Tasks view. Find it in app.hubspot.com/settings/<portal>/users-and-teams
# (or it's the hubspot_owner_id on a task you created).
HUBSPOT_OWNER_ID=

# ---------- Access gate (optional) ----------
# Single shared username/password for the whole app, enforced in middleware.ts
# on pages AND /api. The gate is OFF until ALL THREE of AUTH_USERNAME,
# AUTH_PASSWORD and AUTH_SECRET are set — so leaving them blank keeps the app
# open (e.g. local dev), and setting them turns the gate on with no code change.
AUTH_USERNAME=
AUTH_PASSWORD=
# Signing key for the session cookie. Use a long random string (e.g.
# `openssl rand -hex 32`). Rotating it invalidates all existing sessions.
AUTH_SECRET=
# Set this ALONGSIDE the gate so the weekly Vercel cron can still reach
# /api/github-prospect/sync: Vercel automatically sends it as a bearer token and
# middleware lets that request through. If the gate is on and CRON_SECRET is
# unset, the sync path stays open (unauthenticated) so the poll never breaks —
# set CRON_SECRET to close it. Use another `openssl rand -hex 32` value.
CRON_SECRET=
